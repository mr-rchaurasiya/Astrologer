{
  "name": "vedic-astrology-platform",
  "version": "1.0.0",
  "description": "AI-Powered Vedic Astrology Platform with Deterministic Calculation Engine",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test": "npm run test:server && npm run test:client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "vedic-astrology",
    "jyotish",
    "kundli",
    "astronomy",
    "ai-astrology"
  ],
  "author": "Vedic Astrology Team",
  "license": "UNLICENSED"
}
