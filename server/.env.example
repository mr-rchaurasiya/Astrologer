PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/astrologer_db

JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Phase 5: AI Provider Configuration (Keep secret on server ONLY)
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30000
AI_MAX_CONTEXT_TOKENS=4000
AI_CHAT_REQUESTS_PER_MINUTE=20
CHAT_RETENTION_DAYS=90
